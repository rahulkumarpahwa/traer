            "description": "Public registration (POST /users, no auth). Handler: HandleCreateUser. Requires {email, password} per CreateUserRequest; extra `username` field is IGNORED by code. Returns 201 {\"message\":\"User Signup successfully\"}; 409 if email exists; 400 if email/password empty.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
