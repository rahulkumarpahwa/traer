            "description": "Public login (POST /login, no auth). Handler: HandleLogin. Body {email, password} per LoginRequest — `username` is NOT read by code (only req.Email). Returns 200 {\"message\":\"login successful\",\"user_id\":\"<uuid>\"} + HttpOnly `token` cookie (24h). Cookie jar auto-saves it for auth requests. 401 = invalid credentials.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"ChangeMe123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
