# Traer backend environment configuration.
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must NEVER be committed. Do not reuse your Nextcloud account password here —
# create a dedicated app password in Nextcloud:
#   Settings -> Security -> Devices & sessions -> Create new app password.

# Secret used to sign JWT session cookies. Generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret

# Nextcloud WebDAV destination for the music pipeline.
# Use the internal service address when Traer shares Nextcloud's Docker network
# (see docker-compose.yml), e.g. http://app:80, or your public URL otherwise.
NEXTCLOUD_URL=http://app:80
NEXTCLOUD_USERNAME=your-nextcloud-username
NEXTCLOUD_APP_PASSWORD=your-nextcloud-app-password
NEXTCLOUD_BASE_PATH=Music/Downloads

# Optional overrides (sensible defaults are baked into the image).
# HTTP_ADDRESS=0.0.0.0:8080
# WORKER_INSTANCES=2
# QUEUE_SIZE=100
